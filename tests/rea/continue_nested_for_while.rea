// A continue in a while nested in a for belongs to the while: it must not
// also advance the for's counter.
int visited = 0;
int odd = 0;
for (int i = 0; i < 4; i = i + 1) {
  visited = visited + 1;
  int j = 0;
  while (j < 6) {
    j = j + 1;
    if ((j % 2) == 0) { continue; }
    odd = odd + 1;
  }
}
writeln(visited);
writeln(odd);
